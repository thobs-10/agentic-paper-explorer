QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of origins allowed to call the ingestion API.
ALLOWED_ORIGINS=http://localhost:8501
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_TIMEOUT_SECONDS=15.0
ARXIV_MAX_RETRIES=3
ARXIV_RETRY_BACKOFF_SECONDS=1.0
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3.0
ARXIV_MAX_RESULTS_PER_PAGE=50

QDRANT_COLLECTION_NAME=arxiv_papers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-1234
LITELLM_MODEL_NAME=openrouter/meta-llama/llama-3.2-3b-instruct:free
LITELLM_TEMPERATURE=0.2
LITELLM_MAX_TOKENS=512
LITELLM_TIMEOUT_SECONDS=30.0
LITELLM_MAX_RETRIES=2
LITELLM_RETRY_BACKOFF_SECONDS=0.5
CHUNK_MAX_CHARACTERS=1800
CHUNK_OVERLAP_CHARACTERS=200
