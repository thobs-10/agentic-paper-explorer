{
    "uid": "rag-overview",
    "title": "Agentic Paper Explorer - RAG Overview",
    "tags": [
        "rag",
        "backend",
        "feedback"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "editable": true,
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Request rate by endpoint",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (handler) (rate(http_requests_total{job=\"backend\"}[5m]))",
                    "legendFormat": "{{handler}}"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Request latency (p50 / p95)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {
                        "fillOpacity": 0
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
                    "legendFormat": "p50 {{handler}}"
                },
                {
                    "refId": "B",
                    "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
                    "legendFormat": "p95 {{handler}}"
                }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Degraded answer rate",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 5
                            },
                            {
                                "color": "red",
                                "value": 20
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "area"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "100 * sum(rag_answer_requests_total{outcome=\"degraded\"}) / clamp_min(sum(rag_answer_requests_total), 1)",
                    "legendFormat": "degraded"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Answer satisfaction",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 8,
                "y": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 50
                            },
                            {
                                "color": "green",
                                "value": 75
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "area"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "100 * sum(rag_feedback_total{rating=\"up\"}) / clamp_min(sum(rag_feedback_total), 1)",
                    "legendFormat": "helpful"
                }
            ]
        },
        {
            "id": 5,
            "type": "gauge",
            "title": "Retrieval cache hit ratio",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 16,
                "y": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 25
                            },
                            {
                                "color": "green",
                                "value": 60
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "100 * sum(rag_retrieval_cache_total{result=\"hit\"}) / clamp_min(sum(rag_retrieval_cache_total), 1)",
                    "legendFormat": "cache hits"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "User feedback over time",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 14
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "fillOpacity": 20,
                        "stacking": {
                            "mode": "normal"
                        }
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (rating) (increase(rag_feedback_total[15m]))",
                    "legendFormat": "{{rating}}"
                }
            ]
        },
        {
            "id": 7,
            "type": "bargauge",
            "title": "LLM errors by category (last hour)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 14
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "displayMode": "gradient",
                "orientation": "horizontal"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (category) (increase(rag_llm_errors_total[1h]))",
                    "legendFormat": "{{category}}"
                }
            ]
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Retrieved chunks per query (avg)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 22
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(rag_retrieval_chunks_sum[5m])) / clamp_min(sum(rate(rag_retrieval_chunks_count[5m])), 0.0001)",
                    "legendFormat": "avg chunks"
                }
            ]
        }
    ]
}
